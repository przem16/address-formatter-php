{
    "name": "przem16/address-formatter",
    "description": "Address formatter using country templates from https://github.com/OpenCageData/address-formatting",
    "homepage": "https://github.com/przem16/address-formatter-php",
    "keywords": ["address", "formatter", "geocoding", "postal-address"],
    "type": "library",
    "license": "MIT",
	"support": {
        "issues": "https://github.com/przem16/address-formatter-php/issues"
    },
    "authors": [
        {
            "name": "Przemysław Sidz",
            "homepage": "https://github.com/przem16",
            "role": "Maintainer"
        },
        {
            "name": "PredictHQ",
            "role": "Original author"
        },
        {
            "name": "Robert Kern",
            "role": "Original developer"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "symfony/yaml": ">=4.0",
        "mustache/mustache": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "PredictHQ\\AddressFormatter\\": "src"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    }
}
